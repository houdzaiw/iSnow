final binding = IntegrationTestWidgetsFlutterBinding.ensureInitialized();
final nativeTimeline = <Map<String, Object>>[];
final trace = _NativeTrace();
final checks = <Map<String, Object?>>[];
final playerErrors = <String>[];
Completer<void>? holdPagInit;
Completer<void>? holdPagRelease;
Completer<void>? holdVapConfiguration;
Completer<void>? holdVapStop;
bool _surfaceConvertedForTest = false;

void nativeCheck(String name, Future<void> Function(WidgetTester) body) {
  const filter = String.fromEnvironment('NATIVE_CASE_FILTER');
  if (filter.isNotEmpty && !filter.split(';').any(name.contains)) return;
  testWidgets(name, (tester) async {
    playerErrors.clear();
    try {
      await body(tester);
      expect(playerErrors, isEmpty);
      checks.add({'name': name, 'passed': true});
    } catch (error) {
      checks.add({'name': name, 'passed': false, 'error': '$error'});
      rethrow;
    }
  }, timeout: const Timeout(Duration(seconds: 60)));
}

void configureRecording() {
  binding.framePolicy = LiveTestWidgetsFlutterBindingFramePolicy.fullyLive;
  final messenger = binding.defaultBinaryMessenger;
  const codec = StandardMethodCodec();
  final previous = messenger.allMessagesHandler;
  final previousPrint = debugPrint;
  final incomingRecorded = <String>{};
  setUpAll(() async {
    binding.reportData = {
      'checks': checks,
      'nativeTrace': trace,
      'nativeTimeline': nativeTimeline,
    };
    debugPrint = (message, {wrapWidth}) {
      if (message != null &&
          (message.contains('[RoomGift]') ||
              message.contains('[RoomBarrage]')) &&
          (message.contains('failed') || message.contains('blocked'))) {
        playerErrors.add(message);
      }
      previousPrint(message, wrapWidth: wrapWidth);
    };
    messenger.allMessagesHandler = (channel, handler, message) async {
      final recorded =
          channel == 'flutter_pag_plugin' ||
          channel.startsWith('flutter_vap_controller_');
      String method = '';
      if (recorded && message != null) {
        method = codec.decodeMethodCall(message).method;
        trace.add('$channel:$method:request');
        if (channel.startsWith('flutter_vap_controller_') &&
            incomingRecorded.add(channel)) {
          messenger.delegate.setMessageHandler(channel, (data) {
            if (data != null) {
              final callback = codec.decodeMethodCall(data);
              trace.add('$channel:event:${callback.method}');
            }
            return messenger.handlePlatformMessage(channel, data, null);
          });
        }
      }
      final response = await (handler != null
          ? handler(message)
          : messenger.delegate.send(channel, message));
      if (recorded) {
        trace.add('$channel:$method:nativeReply');
        if (channel == 'flutter_pag_plugin' && method == 'initPag') {
          final gate = holdPagInit;
          if (gate != null) await gate.future;
        }
        if (channel == 'flutter_pag_plugin' && method == 'release') {
          final gate = holdPagRelease;
          if (gate != null) await gate.future;
        }
        if (channel.startsWith('flutter_vap_controller_') &&
            method == 'setFetchResource') {
          final gate = holdVapConfiguration;
          if (gate != null) await gate.future;
        }
        if (channel.startsWith('flutter_vap_controller_') && method == 'stop') {
          final gate = holdVapStop;
          if (gate != null) await gate.future;
        }
        trace.add('$channel:$method:delivered');
      }
      return response;
    };
  });
  setUp(() => _surfaceConvertedForTest = false);
  tearDown(() {
    if (holdPagInit?.isCompleted == false) holdPagInit!.complete();
    holdPagInit = null;
    if (holdPagRelease?.isCompleted == false) holdPagRelease!.complete();
    holdPagRelease = null;
    if (holdVapConfiguration?.isCompleted == false)
      holdVapConfiguration!.complete();
    holdVapConfiguration = null;
    if (holdVapStop?.isCompleted == false) holdVapStop!.complete();
    holdVapStop = null;
  });
  tearDownAll(() async {
    // Retain a local report even if ADB disconnects before the host receives it.
    final report = File(
      '${(await getTemporaryDirectory()).path}/native_qa_report.json',
    );
    await report.writeAsString(
      jsonEncode({
        'checks': checks,
        'nativeTrace': trace.toList(),
        'nativeTimeline': nativeTimeline,
      }),
      flush: true,
    );
    messenger.allMessagesHandler = previous;
    debugPrint = previousPrint;
  });
}

class _NativeTrace extends ListBase<String> {
  final List<String> _events = [];
  @override
  int get length => _events.length;
  @override
  set length(int value) => _events.length = value;
  @override
  String operator [](int index) => _events[index];
  @override
  void operator []=(int index, String value) => _events[index] = value;
  @override
  void add(String value) {
    _events.add(value);
    nativeTimeline.add({
      'at': DateTime.now().toUtc().toIso8601String(),
      'event': value,
    });
  }
}

Future<RoomGiftAnimationResource> resource(
  RoomGiftAnimationFormat format, {
  bool longLoop = false,
  bool decoderFixture = false,
}) async {
  final asset = decoderFixture
      ? 'sample.svga'
      : longLoop
      ? 'long_loop_vap.mp4'
      : switch (format) {
          RoomGiftAnimationFormat.svga => 'sample_visual.svga',
          RoomGiftAnimationFormat.pag => 'sample.pag',
          RoomGiftAnimationFormat.vap => 'sample_vap.mp4',
          _ => 'sample.mp4',
        };
  final data = (await rootBundle.load('assets/qa/$asset')).buffer.asUint8List();
  File? file;
  if (format == RoomGiftAnimationFormat.mp4 ||
      format == RoomGiftAnimationFormat.vap) {
    file = File('${(await getTemporaryDirectory()).path}/$asset');
    await file.writeAsBytes(data, flush: true);
  }
  return RoomGiftAnimationResource(
    format: format,
    videoMode: 1,
    bytes: data,
    file: file,
  );
}

Future<void> scene(
  WidgetTester tester,
  Widget child, {
  List<Override> overrides = const [],
}) async {
  debugPrint('[NativeQA] Mounting production scene');
  Widget app(Widget body) => ProviderScope(
    overrides: overrides,
    child: ScreenUtilInit(
      designSize: const Size(375, 812),
      builder: (context, _) => MaterialApp(
        theme: AppTheme.light,
        home: Scaffold(body: SafeArea(child: body)),
      ),
    ),
  );
  if (!_surfaceConvertedForTest) {
    // Render a real Flutter frame first, then prepare screenshot capture before
    // creating native views. Switching surfaces during video playback can reset
    // the decoder and capture its transparent initialization frame instead.
    await tester.pumpWidget(app(const SizedBox.shrink()));
    await tester.pump();
    await binding.convertFlutterSurfaceToImage();
    _surfaceConvertedForTest = true;
    await tester.pump();
    debugPrint('[NativeQA] Capture surface ready before native scene');
  }
  await tester.pumpWidget(app(child));
  debugPrint('[NativeQA] Production scene mounted');
  addTearDown(() async {
    await tester.pumpWidget(const SizedBox.shrink());
    await tester.pump(const Duration(milliseconds: 300));
  });
}

Future<void> until(
  WidgetTester tester,
  bool Function() condition, {
  int seconds = 8,
}) async {
  final end = DateTime.now().add(Duration(seconds: seconds));
  while (!condition() && DateTime.now().isBefore(end)) {
    await tester.pump(const Duration(milliseconds: 40));
  }
  expect(
    condition(),
    isTrue,
    reason: 'Native condition not reached within ${seconds}s',
  );
}

Future<void> capture(
  WidgetTester tester,
  String name, {
  int attempts = 1,
}) async {
  // Converting an unrendered SurfaceView can keep a physical phone on its
  // launch splash. The SDK reverts this conversion in this test's tearDown.
  if (!_surfaceConvertedForTest) {
    await binding.convertFlutterSurfaceToImage();
    _surfaceConvertedForTest = true;
    debugPrint('[NativeQA] $name surface converted after scene mount');
  }
  var foreground = 0;
  for (var attempt = 0; attempt < attempts; attempt++) {
    await tester.pump(const Duration(milliseconds: 400));
    final captureName = attempt == 0 ? name : '${name}_retry$attempt';
    final png = await binding
        .takeScreenshot(captureName)
        .timeout(const Duration(seconds: 15));
    final backup = Directory(
      '${(await getTemporaryDirectory()).path}/native_qa_frames',
    );
    await backup.create(recursive: true);
    await File(
      '${backup.path}/$captureName.png',
    ).writeAsBytes(png, flush: true);
    final codec = await ui.instantiateImageCodec(Uint8List.fromList(png));
    final frame = await codec.getNextFrame();
    final pixels = await frame.image.toByteData(
      format: ui.ImageByteFormat.rawRgba,
    );
    final width = frame.image.width, height = frame.image.height;
    final bytes = pixels!.buffer.asUint8List();
    final background = AppTheme.light.scaffoldBackgroundColor.toARGB32();
    final red = (background >> 16) & 255;
    final green = (background >> 8) & 255;
    final blue = background & 255;
    foreground = 0;
    for (var y = height ~/ 8; y < height * 9 ~/ 10; y += 8) {
      for (var x = 8; x < width - 8; x += 8) {
        final offset = (y * width + x) * 4;
        if ((bytes[offset] - red).abs() > 16 ||
            (bytes[offset + 1] - green).abs() > 16 ||
            (bytes[offset + 2] - blue).abs() > 16)
          foreground++;
      }
    }
    frame.image.dispose();
    codec.dispose();
    trace.add('frame:$captureName:foregroundSamples=$foreground');
    if (foreground > 8) return;
  }
  expect(
    foreground,
    greaterThan(8),
    reason: '$name screenshot contains no visible fixture',
  );
}
