flowchart TD
  A["接口请求开始"] --> B["记录 stage、env、method、path"]
  B --> C["生成 headersSummary 和 paramsSummary"]
  C --> D["脱敏手机号、密码、验证码、token"]
  D --> E["发起 Dio 请求"]
  E --> F{"请求结果"}
  F -- "网络失败" --> G["记录 DioException 类型和耗时"]
  F -- "HTTP 错误" --> H["记录 statusCode 和响应摘要"]
  F -- "业务失败" --> I["记录 code、message、traceId"]
  F -- "成功" --> J["记录 code、traceId、durationMs"]
  G --> K["UI 保留输入并显示重试"]
  H --> K
  I --> K
  J --> L["更新页面状态和持久化数据"]
