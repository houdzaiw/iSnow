flowchart TD
  A["登录态恢复成功"] --> B["进入个人页"]
  B --> C["请求 /api/user/mine"]
  C --> D{"资料是否加载成功"}
  D -- "否" --> E["展示错误和重试入口"]
  D -- "是" --> F["展示头像、昵称、性别、生日、国家、手机号、用户 ID、简介"]
  F --> G["用户点击编辑资料"]
  G --> H["编辑头像、昵称、性别、生日、简介"]
  H --> I{"是否修改头像"}
  I -- "是" --> J["请求 /api/resource/header-upload-param"]
  J --> K{"上传参数是否可用"}
  K -- "否" --> L["停止保存并提示上传失败"]
  K -- "是" --> M["客户端直传 OSS 获取 avatar URL"]
  M --> N["请求 /api/user/modifyUser"]
  I -- "否" --> N
  N --> O{"保存是否成功"}
  O -- "否" --> P["展示后端 message 并记录 traceId"]
  O -- "是" --> Q["刷新本地资料和 /api/user/mine 数据"]
