flowchart TD
  A["开始 iSnow 视觉体系迁移"] --> B["确认一期页面范围"]
  B --> C["从 Lanhu 获取设计图与切图资源"]
  C --> D{"资源是否为一期页面实际需要"}
  D -->|是| E["下载资源并语义化命名"]
  D -->|否| F["跳过下载，避免 assets 膨胀"]
  E --> G["建立 AppAssets 资源映射"]
  G --> H["抽取设计 Token"]
  H --> H1["AppColors"]
  H --> H2["AppGradients"]
  H --> H3["AppSpacing"]
  H --> H4["AppRadius"]
  H --> H5["AppTextStyles"]
  H --> H6["AppShadows"]
  H1 --> I["生成 AppTheme"]
  H2 --> I
  H3 --> I
  H4 --> I
  H5 --> I
  H6 --> I
  I --> J["替换页面内硬编码颜色与资源路径"]
  J --> K["迁移登录注册视觉"]
  J --> L["迁移首页与捞球弹窗视觉"]
  J --> M["迁移日历与发布心情视觉"]
  J --> N["迁移聊天与聊天设置视觉"]
  J --> O["迁移我的与编辑资料视觉"]
  K --> P["运行 Flutter 静态检查"]
  L --> P
  M --> P
  N --> P
  O --> P
  P --> Q{"是否存在缺失图标"}
  Q -->|有| R["使用红色 TODO 占位并登记待补清单"]
  Q -->|无| S["进入视觉验收"]
  R --> S
  S --> T["检查颜色、icon、间距、圆角、字体、阴影"]
  T --> U{"是否满足一期验收"}
  U -->|否| V["回到对应 Token 或页面调整"]
  V --> J
  U -->|是| W["完成一期视觉体系迁移"]
