flowchart TD
  A["用户打开 App"] --> B{"是否已登录"}
  B -->|否| C["登录页"]
  C --> D["点击登录"]
  C --> E["点击注册"]
  E --> F["填写邮箱、密码、确认密码"]
  F --> G{"字段校验是否通过"}
  G -->|否| G1["展示错误提示并停留注册页"]
  G -->|是| H["协议弹窗"]
  H --> I{"是否同意服务条款与隐私政策"}
  I -->|否| C
  I -->|是| J["进入首页"]
  D --> J
  B -->|是| J

  J --> J1["首页浏览"]
  J1 --> J2["点击捞一个"]
  J2 --> J3["展示随机心情卡片弹窗"]
  J3 --> J4["点击打开进入心情详情"]

  J --> K["切换到日历 Tab"]
  K --> K1["查看月视图"]
  K1 --> K2["切换月份"]
  K1 --> K3["展开或折叠日历"]
  K1 --> K4["点击加号"]
  K4 --> K5["选择心情"]
  K5 --> K6["填写文字或录音"]
  K6 --> K7{"发布是否成功"}
  K7 -->|否| K8["提示失败并允许重试"]
  K7 -->|是| K9["刷新当天心情记录"]
  K9 --> K1

  J --> L["切换到聊天 Tab"]
  L --> L1["进入会话"]
  L1 --> L2["输入消息并发送"]
  L2 --> L3{"是否被拉黑或网络异常"}
  L3 -->|是| L4["展示发送失败或不可发送提示"]
  L3 -->|否| L5["消息进入会话列表"]
  L1 --> L6["进入聊天设置"]
  L6 --> L7["设置拉黑聊天或免打扰"]

  J --> M["切换到我的 Tab"]
  M --> M1["查看个人资料与菜单"]
  M1 --> M2["进入编辑资料"]
  M2 --> M3["修改头像、昵称、性别、生日"]
  M3 --> M4{"保存是否成功"}
  M4 -->|否| M5["展示失败提示并保留输入"]
  M4 -->|是| M6["返回我的并刷新资料"]
